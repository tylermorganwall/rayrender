CXX_STD = CXX20

## Compiler flags/defines:
PKG_CPPFLAGS = @PKG_CPPFLAGS@ 
PKG_LIBS = @PKG_LIBS@
PKG_CXXFLAGS = @DEFINES@ @PKG_CXXFLAGS@

## Files to compile:
C_SOURCES=@EXT_C_SOURCES@
C_OBJECTS=$(C_SOURCES:.c=.o)

## Add in PBRT_SOURCES later
CPP_SOURCES=@DIR_SOURCES@ @SUBDIR_SOURCES@ @EXT_CPP_SOURCES@
CPP_OBJECTS=$(CPP_SOURCES:.cpp=.o)

OBJECTS=$(C_OBJECTS) $(CPP_OBJECTS)

$(SHLIB): $(OBJECTS)

# Keep virtual sampler/light interfaces consistent during incremental builds.
$(CPP_OBJECTS): math/sampler.h lights/infinite.h math/distributions.h
$(CPP_OBJECTS): core/wavefront.h
core/wavefront.o core/wavefront_motion.o core/wavefront_camera_tests.o: core/wavefront_motion.h
core/wavefront_metal.o: core/wavefront_motion.h
core/wavefront.o: core/wavefront_texture_export.inc core/wavefront_instances.inc core/wavefront_medium_export.inc core/wavefront_light_bvh.inc

# Make the shared object
all: $(SHLIB)

# CSG vtables are shared by construction, boundaries and CPU/GPU exporters.
$(CPP_OBJECTS): hitables/csg.h

# Texture descriptors cross exporter/material translation units.
$(CPP_OBJECTS): materials/texturegraph.h materials/ptextexture.h
