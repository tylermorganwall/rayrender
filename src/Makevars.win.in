CXX_STD = CXX20

## Compiler flags/defines:
PKG_CPPFLAGS = @PKG_CPPFLAGS@ 
PKG_LIBS = @PKG_LIBS@
PKG_CXXFLAGS = @DEFINES@ @PKG_CXXFLAGS@

## Files to compile:
C_SOURCES=@EXT_C_SOURCES@
C_OBJECTS=$(C_SOURCES:.c=.o)

## Add in PBRT_SOURCES later
CPP_SOURCES=@DIR_SOURCES@ @SUBDIR_SOURCES@ @EXT_CPP_SOURCES@
CPP_OBJECTS=$(CPP_SOURCES:.cpp=.o)

OBJECTS=$(C_OBJECTS) $(CPP_OBJECTS)

$(SHLIB): $(OBJECTS)

# Keep virtual sampler/light interfaces consistent during incremental builds.
$(CPP_OBJECTS): math/sampler.h lights/infinite.h math/distributions.h
$(CPP_OBJECTS): math/animatedtransform.h math/keyframe.h
core/buildscene.o model_animation_rcpp.o math/model_animation.o math/model_animation_tests.o: math/model_animation.h model_animation_rcpp.h
core/buildscene.o render_scene_rcpp.o render_animation_rcpp.o: core/buildscene.h
gltf_rcpp.o: math/quaternion.h
$(CPP_OBJECTS): core/timeline.h core/camera_track.h
$(CPP_OBJECTS): core/camera.h
$(CPP_OBJECTS): core/wavefront_motion_layout.h
$(CPP_OBJECTS): core/wavefront.h
render_scene_rcpp.o render_animation_rcpp.o: core/wavefront_report.h
$(CPP_OBJECTS): core/integrator.h
$(CPP_OBJECTS): core/PreviewDisplay.h core/preview_navigation.h core/preview_navigation_input.h
# Per-hit closures change scatter_record layout across material/integrator calls.
$(CPP_OBJECTS): materials/material.h materials/normalmap.h math/pdf.h
$(CPP_OBJECTS): volumes/medium.h
core/wavefront.o core/wavefront_motion.o core/wavefront_atmosphere.o core/wavefront_camera_tests.o: core/wavefront_motion.h
core/wavefront_metal.o: core/wavefront_motion.h
core/wavefront.o: core/wavefront_texture_export.inc core/wavefront_instances.inc core/wavefront_medium_export.inc core/wavefront_light_bvh.inc

# Make the shared object
all: $(SHLIB)

# CSG vtables are shared by construction, boundaries and CPU/GPU exporters.
$(CPP_OBJECTS): hitables/csg.h

# Texture descriptors cross exporter/material translation units.
$(CPP_OBJECTS): materials/texturegraph.h materials/ptextexture.h

# Deformation ownership and mesh layout are shared with CPU/Metal exporters.
$(CPP_OBJECTS): math/model_animation.h math/model_deformation.h hitables/mesh3d.h core/bvh.h
model_animation_rcpp.o model_deformation_rcpp.o: model_deformation_rcpp.h

render_scene_rcpp.o render_animation_rcpp.o: core/animation_report.h

# Stable native mesh bindings support in-place Metal deformation refits.
core/wavefront.o core/wavefront_deformation.o core/wavefront_deformation_tests.o core/wavefront_metal.o: core/wavefront_deformation.h

# Shared temporal sampler used by the integrator and its native acceptance tests.
core/integrator.o math/keyframe_tests.o: core/full_pose_shutter.h
$(CPP_OBJECTS): core/camera.h math/animatedtransform.h
