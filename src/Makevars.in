CXX_STD = CXX20

## Compiler flags/defines:
PKG_CPPFLAGS = @PKG_CPPFLAGS@ 
PKG_LIBS = @PKG_LIBS@
PKG_CXXFLAGS = @DEFINES@ @PKG_CXXFLAGS@

## Files to compile:
C_SOURCES=@EXT_C_SOURCES@
C_OBJECTS=$(C_SOURCES:.c=.o)

## Add in PBRT_SOURCES later
CPP_SOURCES=@DIR_SOURCES@ @SUBDIR_SOURCES@ @EXT_CPP_SOURCES@
CPP_OBJECTS=$(CPP_SOURCES:.cpp=.o)

OBJECTS=$(C_OBJECTS) $(CPP_OBJECTS) @METAL_OBJECTS@

$(SHLIB): $(OBJECTS)

# These interfaces are used through virtual calls across translation units.
# An incremental install must not mix old sampler/light vtables with new ones.
$(CPP_OBJECTS): math/sampler.h lights/infinite.h math/distributions.h
$(CPP_OBJECTS): core/wavefront.h
render_scene_rcpp.o render_animation_rcpp.o: core/wavefront_report.h
$(CPP_OBJECTS): core/integrator.h
$(CPP_OBJECTS): core/PreviewDisplay.h core/preview_navigation.h core/preview_navigation_input.h
# Per-hit closures change scatter_record layout across material/integrator calls.
$(CPP_OBJECTS): materials/material.h materials/normalmap.h math/pdf.h
$(CPP_OBJECTS): volumes/medium.h

core/hlbvh_metal.o: core/hlbvh_metal.mm core/hlbvh.h
	$(CXX) $(CXXSTD) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -fobjc-arc -c $< -o $@

# These translation units own or inspect the shared host/device scene ABI.
# Rebuild them on layout changes even during an incremental R installation.
render_scene_rcpp.o render_animation_rcpp.o core/integrator.o core/wavefront_geometry.o core/wavefront_tests.o core/wavefront_material_tests.o core/wavefront_texture_tests.o core/wavefront_geometry_tests.o core/wavefront_environment_tests.o: core/wavefront.h

core/wavefront.o: core/wavefront.h core/wavefront_texture_export.inc core/wavefront_instances.inc core/wavefront_medium_export.inc core/wavefront_light_bvh.inc
core/wavefront.o core/wavefront_motion.o core/wavefront_camera_tests.o: core/wavefront_motion.h
core/wavefront_metal.o: core/wavefront_motion.h
core/wavefront_metal.o core/wavefront_medium_tests.o: core/wavefront_medium_probe.h

core/wavefront_metal.o: core/wavefront_metal.mm core/wavefront.h core/wavefront_kernels.inc core/wavefront_textures.inc core/wavefront_bump.inc core/wavefront_intersections.inc core/wavefront_csg.inc core/wavefront_bsdf.inc core/wavefront_diffusion.inc core/wavefront_openpbr.inc core/wavefront_openpbr_generated.inc core/wavefront_openpbr_fields.inc core/wavefront_probes.inc core/wavefront_media.inc core/wavefront_atmosphere.inc core/wavefront_atmosphere_paths.inc core/wavefront_haze.inc core/wavefront_camera.inc core/wavefront_light_sampling.inc core/wavefront_subsurface_sampling.inc core/wavefront_curves.inc core/wavefront_ray_motion.inc
	$(CXX) $(CXXSTD) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -fobjc-arc -c $< -o $@

# Make the shared object
all: $(SHLIB)

# CSG vtables are shared by construction, boundaries and CPU/GPU exporters.
$(CPP_OBJECTS): hitables/csg.h

# Texture descriptors cross exporter/material translation units.
$(CPP_OBJECTS): materials/texturegraph.h materials/ptextexture.h
