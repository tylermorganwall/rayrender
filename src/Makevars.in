CXX_STD = CXX20

## Compiler flags/defines:
PKG_CPPFLAGS = @PKG_CPPFLAGS@ 
PKG_LIBS = @PKG_LIBS@
PKG_CXXFLAGS = @DEFINES@ @PKG_CXXFLAGS@

## Files to compile:
C_SOURCES=@EXT_C_SOURCES@
C_OBJECTS=$(C_SOURCES:.c=.o)

## Add in PBRT_SOURCES later
CPP_SOURCES=@DIR_SOURCES@ @SUBDIR_SOURCES@ @EXT_CPP_SOURCES@
CPP_OBJECTS=$(CPP_SOURCES:.cpp=.o)

OBJECTS=$(C_OBJECTS) $(CPP_OBJECTS) @METAL_OBJECTS@

$(SHLIB): $(OBJECTS)

core/hlbvh_metal.o: core/hlbvh_metal.mm core/hlbvh.h
	$(CXX) $(CXXSTD) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -fobjc-arc -c $< -o $@

core/wavefront_metal.o: core/wavefront_metal.mm core/wavefront.h core/wavefront_kernels.inc
	$(CXX) $(CXXSTD) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -fobjc-arc -c $< -o $@

# Make the shared object
all: $(SHLIB)
